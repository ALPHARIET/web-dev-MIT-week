# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opsional: alamat proxy yang meneruskan format Gemini (contoh: http://host:port).
# Kosongkan untuk langsung ke https://generativelanguage.googleapis.com
GEMINI_BASE_URL=

# Google Safe Browsing API Key (v4 Lookup API)
SAFE_BROWSING_API_KEY=

# Upstash Redis REST credentials (for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# P1 Optional APIs
VIRUSTOTAL_API_KEY=
